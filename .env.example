# Local only. Configure actual secrets privately in .env.local or your secret manager.
DATABASE_URL=postgresql://mailcraft_runtime:mailcraft_local_runtime@127.0.0.1:55439/mailcraft
MIGRATION_DATABASE_URL=postgresql://mailcraft_migration:mailcraft_local_migration@127.0.0.1:55439/mailcraft
REDIS_URL=redis://127.0.0.1:56379
APP_ORIGIN=http://127.0.0.1:3000
LOCAL_DEVELOPMENT=true
# Local bootstrap enabled only outside production, on loopback, with this secret.
LOCAL_BOOTSTRAP_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_MAX_OUTPUT_TOKENS=4000
# Paid operations also require a configured finite allowance (default 0).
AI_GENERATION_ALLOWANCE=0
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
PREFERENCE_SIGNING_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Sending remains disabled until release gates are signed and verified.
DISPATCH_ENABLED=false

# Dedicated isolated renderer; configure only the same private render key on web/renderer.
RENDER_WORKER_URL=
RENDER_WORKER_SECRET=
# Approved finite storage bytes required in production; no automatic old-export deletion.
RENDER_CACHE_ALLOWANCE_BYTES=
