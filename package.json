{
  "name": "mailcraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "worker": "node --import tsx src/server/worker.ts",
    "release:check": "node --import tsx scripts/release-check.ts",
    "smoke:preflight": "node --import tsx scripts/smoke-preflight.ts",
    "smoke:render-cache": "node --import tsx scripts/smoke-render-cache.ts && node --import tsx scripts/smoke-render-editor.ts",
    "smoke:derivation": "node --import tsx scripts/smoke-derivation.ts",
    "smoke:api": "node --import tsx scripts/smoke-api.ts",
    "smoke:import": "node --import tsx scripts/smoke-import.ts",
    "smoke:preferences": "node --import tsx scripts/smoke-preferences.ts",
    "smoke:keys": "node --import tsx scripts/smoke-keys.ts && node --import tsx scripts/smoke-key-review.ts",
    "api:generate": "node --import tsx scripts/generate-api.ts",
    "api:check": "node --import tsx scripts/generate-api.ts --check",
    "smoke:contract": "node --import tsx scripts/smoke-pagination.ts && node --import tsx scripts/smoke-contract-review.ts",
    "smoke:events": "node --import tsx scripts/smoke-events.ts",
    "smoke:dispatch-controls": "node --import tsx scripts/smoke-dispatch-controls.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.9",
    "@fontsource/inter": "5.3.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "bullmq": "6.3.11",
    "cheerio": "1.2.0",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.3",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
